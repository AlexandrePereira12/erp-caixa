# Configuração global da instalação (copiada para <RAIZ>/config.env pelo preparar-servidor.sh,
# que nunca sobrescreve um arquivo existente). Sem segredos aqui.
DOMINIO_BASE=
ACME_EMAIL=
TIMEZONE_PADRAO=America/Fortaleza

# Imagens (tag escolhida por empresa no provisionamento/atualização)
IMAGE_API=sistema-pdv-api
IMAGE_WEB=sistema-pdv-web
IMAGE_DB=postgres:16-alpine
IMAGE_CERTBOT=certbot/certbot:v2.11.0
IMAGE_TAG=dev

# Backups: retenção local em dias; cópia fora da VPS por rclone quando BACKUP_RCLONE_REMOTE existir
# (ex.: oci-bucket:pdv-backups). BACKUP_REMOTO_RETENCAO_DIAS vale para o destino remoto.
BACKUP_RETENCAO_DIAS=14
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTO_RETENCAO_DIAS=56

# Cópia fora da VPS: o remote precisa ser do tipo crypt (o dump tem dados pessoais).
# BACKUP_PERMITIR_REMOTO_SEM_CRIPTOGRAFIA=1 aceita remote sem cifra (não recomendado).
BACKUP_PERMITIR_REMOTO_SEM_CRIPTOGRAFIA=0
